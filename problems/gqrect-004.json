{
  "id": "gqrect-004",
  "title": "Right and bottom edges",
  "concept": "gq-rect",
  "difficulty": 0,
  "prompt": "Return the bottom-right corner of the rectangle as a Vector2. For a rect at (10, 20) sized (30, 40) that is (40, 60).",
  "signature": "func solve(r) -> Vector2:",
  "starter": "func solve(r) -> Vector2:\n\treturn r.position",
  "tests": [
    {
      "name": "(10, 20) + (30, 40) is (40, 60)",
      "args": [
        {
          "$rect": [
            10,
            20,
            30,
            40
          ]
        }
      ],
      "expect": {
        "$v2": [
          40,
          60
        ]
      }
    },
    {
      "name": "5 by 5 at origin ends at (5, 5)",
      "args": [
        {
          "$rect": [
            0,
            0,
            5,
            5
          ]
        }
      ],
      "expect": {
        "$v2": [
          5,
          5
        ]
      }
    }
  ],
  "hints": [
    "Position plus size, or the rect property called end.",
    "`return r.end`"
  ],
  "docs": [
    {
      "name": "r.position, r.size, r.end",
      "what": "The top-left corner, the width and height, and the bottom-right corner, all Vector2."
    }
  ],
  "solution": "func solve(r) -> Vector2:\n\treturn r.end"
}
