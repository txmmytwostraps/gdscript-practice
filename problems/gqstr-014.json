{
  "id": "gqstr-014",
  "title": "Reverse a string",
  "concept": "gq-strings",
  "difficulty": 1,
  "prompt": "Return the text backwards, so \"abc\" becomes \"cba\".",
  "signature": "func solve(text):",
  "starter": "func solve(text):\n\treturn text",
  "tests": [
    {
      "name": "abc becomes cba",
      "args": [
        "abc"
      ],
      "expect": "cba"
    },
    {
      "name": "Empty stays empty",
      "args": [
        ""
      ],
      "expect": ""
    },
    {
      "name": "Godot becomes todoG",
      "args": [
        "Godot"
      ],
      "expect": "todoG"
    }
  ],
  "hints": [
    "Unlike arrays, a string's reverse method returns the new string.",
    "`return text.reverse()`"
  ],
  "docs": [
    {
      "name": "text.reverse()",
      "what": "Returns the text backwards. Unlike arrays, this returns a new string."
    }
  ],
  "solution": "func solve(text):\n\treturn text.reverse()",
  "generator": [
    {
      "pick": [
        "abc",
        "",
        "Godot"
      ]
    }
  ]
}
