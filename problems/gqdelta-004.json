{
  "id": "gqdelta-004",
  "title": "Frames to seconds",
  "concept": "gq-delta",
  "difficulty": 0,
  "prompt": "Every frame lasts delta seconds. Return how many seconds a number of frames lasts. 50 frames of 0.02 s is 1.0 second.",
  "signature": "func solve(frames, delta) -> float:",
  "starter": "func solve(frames, delta) -> float:\n\treturn 0.0",
  "tests": [
    {
      "name": "50 frames of 0.02 s is 1 s",
      "args": [
        50,
        0.02
      ],
      "expect": 1
    },
    {
      "name": "25 frames of 0.02 s is 0.5 s",
      "args": [
        25,
        0.02
      ],
      "expect": 0.5
    },
    {
      "name": "0 frames is 0 s",
      "args": [
        0,
        0.016
      ],
      "expect": 0
    }
  ],
  "hints": [
    "Count times the length of each.",
    "`return frames * delta`"
  ],
  "docs": [],
  "solution": "func solve(frames, delta) -> float:\n\treturn frames * delta"
}
