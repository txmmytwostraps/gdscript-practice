{
  "id": "gqstr-021",
  "title": "Long enough password",
  "concept": "gq-strings",
  "difficulty": 0,
  "prompt": "Return true if the password has at least 8 characters.",
  "signature": "func is_long_enough(password):",
  "fn": "is_long_enough",
  "starter": "func is_long_enough(password):\n\treturn false",
  "tests": [
    {
      "name": "8 characters is enough",
      "args": [
        "abcdefgh"
      ],
      "expect": true
    },
    {
      "name": "short is not",
      "args": [
        "short"
      ],
      "expect": false
    },
    {
      "name": "Longer is fine",
      "args": [
        "longer than eight"
      ],
      "expect": true
    }
  ],
  "hints": [
    "Get the length, then compare it.",
    "`return password.length() >= 8`"
  ],
  "docs": [
    {
      "name": "text.length()",
      "what": "Returns how many characters the string has."
    }
  ],
  "solution": "func is_long_enough(password):\n\treturn password.length() >= 8",
  "generator": [
    {
      "pick": [
        "abcdefgh",
        "short",
        "longer than eight"
      ]
    }
  ]
}
