{
  "id": "gqstr-013",
  "title": "Count a letter, now with count()",
  "concept": "gq-strings",
  "difficulty": 0,
  "prompt": "Same task with the built-in count method.",
  "signature": "func solve(text, letter):",
  "starter": "func solve(text, letter):\n\treturn 0",
  "tests": [
    {
      "name": "banana has 3 a's",
      "args": [
        "banana",
        "a"
      ],
      "expect": 3
    },
    {
      "name": "hello has no z",
      "args": [
        "hello",
        "z"
      ],
      "expect": 0
    },
    {
      "name": "Empty has none",
      "args": [
        "",
        "a"
      ],
      "expect": 0
    }
  ],
  "hints": [
    "Strings and arrays both have count.",
    "`return text.count(letter)`"
  ],
  "docs": [
    {
      "name": "text.count(part)",
      "what": "Returns how many times part appears."
    }
  ],
  "solution": "func solve(text, letter):\n\treturn text.count(letter)"
}
