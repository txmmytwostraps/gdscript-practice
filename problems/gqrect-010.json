{
  "id": "gqrect-010",
  "title": "Is the point inside",
  "concept": "gq-rect",
  "difficulty": 0,
  "prompt": "Return true if the point lies inside the rectangle.",
  "signature": "func solve(r, point):",
  "starter": "func solve(r, point):\n\treturn false",
  "tests": [
    {
      "name": "(5, 5) is inside a 10 by 10",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        },
        {
          "$v2": [
            5,
            5
          ]
        }
      ],
      "expect": true
    },
    {
      "name": "(15, 5) is outside",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        },
        {
          "$v2": [
            15,
            5
          ]
        }
      ],
      "expect": false
    },
    {
      "name": "Inside an offset rect",
      "args": [
        {
          "$rect": [
            10,
            10,
            5,
            5
          ]
        },
        {
          "$v2": [
            12,
            14
          ]
        }
      ],
      "expect": true
    }
  ],
  "hints": [
    "There is a method for this; its name mentions a point.",
    "`return r.has_point(point)`"
  ],
  "docs": [
    {
      "name": "r.has_point(point)",
      "what": "Returns true if the point lies inside the rectangle."
    }
  ],
  "solution": "func solve(r, point):\n\treturn r.has_point(point)",
  "generator": [
    {
      "rect": [
        [
          0,
          15
        ],
        [
          0,
          15
        ],
        [
          2,
          13
        ],
        [
          2,
          13
        ]
      ]
    },
    {
      "v2": [
        [
          1,
          20
        ],
        [
          1,
          19
        ],
        0
      ]
    }
  ]
}
