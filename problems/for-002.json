{
  "id": "for-002",
  "title": "Count the evens",
  "concept": "for",
  "difficulty": 0,
  "prompt": "Return how many numbers in the array are even.",
  "signature": "func solve(nums: Array) -> int:",
  "starter": "func solve(nums: Array) -> int:\n\treturn 0",
  "tests": [
    {
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expect": 2
    },
    {
      "args": [
        [
          1,
          3,
          5
        ]
      ],
      "expect": 0
    },
    {
      "args": [
        []
      ],
      "expect": 0
    },
    {
      "args": [
        [
          2,
          4,
          6,
          8
        ]
      ],
      "expect": 4
    },
    {
      "args": [
        [
          0
        ]
      ],
      "expect": 1
    }
  ],
  "hint": "Loop over the numbers and use `if n % 2 == 0:` to add one to a counter.",
  "solution": "func solve(nums: Array) -> int:\n\tvar count = 0\n\tfor n in nums:\n\t\tif n % 2 == 0:\n\t\t\tcount += 1\n\treturn count"
}
