{
  "id": "gqvec-008",
  "title": "Direction of length 1",
  "concept": "gq-vectors",
  "difficulty": 1,
  "prompt": "Return a vector pointing the same way as v but with length exactly 1. Games use these to say which way the robot faces. (3, 4) becomes (0.6, 0.8).",
  "signature": "func solve(v) -> Vector2:",
  "starter": "func solve(v) -> Vector2:\n\treturn v",
  "tests": [
    {
      "name": "(3, 4) becomes (0.6, 0.8)",
      "args": [
        {
          "$v2": [
            3,
            4
          ]
        }
      ],
      "expect": {
        "$v2": [
          0.6,
          0.8
        ]
      }
    },
    {
      "name": "(0, 5) becomes (0, 1)",
      "args": [
        {
          "$v2": [
            0,
            5
          ]
        }
      ],
      "expect": {
        "$v2": [
          0,
          1
        ]
      }
    },
    {
      "name": "(-2, 0) becomes (-1, 0)",
      "args": [
        {
          "$v2": [
            -2,
            0
          ]
        }
      ],
      "expect": {
        "$v2": [
          -1,
          0
        ]
      }
    }
  ],
  "hints": [
    "This is called normalizing.",
    "`return v.normalized()`"
  ],
  "docs": [
    {
      "name": "v.normalized()",
      "what": "Returns a vector pointing the same way with length 1."
    }
  ],
  "solution": "func solve(v) -> Vector2:\n\treturn v.normalized()"
}
