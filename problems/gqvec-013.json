{
  "id": "gqvec-013",
  "title": "Which is farther",
  "concept": "gq-vectors",
  "difficulty": 1,
  "prompt": "Two points a and b. Return \"a\" if a is farther from (0, 0), otherwise \"b\".",
  "signature": "func solve(a, b):",
  "starter": "func solve(a, b):\n\treturn \"a\"",
  "tests": [
    {
      "name": "(3, 4) is farther than (1, 1)",
      "args": [
        {
          "$v2": [
            3,
            4
          ]
        },
        {
          "$v2": [
            1,
            1
          ]
        }
      ],
      "expect": "a"
    },
    {
      "name": "(0, 2) is farther than (1, 0)",
      "args": [
        {
          "$v2": [
            1,
            0
          ]
        },
        {
          "$v2": [
            0,
            2
          ]
        }
      ],
      "expect": "b"
    },
    {
      "name": "Equal returns b",
      "args": [
        {
          "$v2": [
            0,
            0
          ]
        },
        {
          "$v2": [
            0,
            0
          ]
        }
      ],
      "expect": "b"
    }
  ],
  "hints": [
    "Compare the two lengths with an if.",
    "`if a.length() > b.length():` return \"a\", else \"b\"."
  ],
  "docs": [
    {
      "name": "v.length()",
      "what": "Returns the length of the vector as a float."
    }
  ],
  "solution": "func solve(a, b):\n\tif a.length() > b.length():\n\t\treturn \"a\"\n\telse:\n\t\treturn \"b\""
}
