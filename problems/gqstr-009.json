{
  "id": "gqstr-009",
  "title": "Starts with",
  "concept": "gq-strings",
  "difficulty": 0,
  "prompt": "Return true if the text begins with the given prefix.",
  "signature": "func solve(text, prefix):",
  "starter": "func solve(text, prefix):\n\treturn false",
  "tests": [
    {
      "name": "A web address starts with https",
      "args": [
        "https://godotengine.org",
        "https"
      ],
      "expect": true
    },
    {
      "name": "ftp does not",
      "args": [
        "ftp://x",
        "https"
      ],
      "expect": false
    },
    {
      "name": "Everything starts with nothing",
      "args": [
        "abc",
        ""
      ],
      "expect": true
    }
  ],
  "hints": [
    "Godot names this method begins_with, not starts_with.",
    "`return text.begins_with(prefix)`"
  ],
  "docs": [
    {
      "name": "text.begins_with(prefix)",
      "what": "Returns true if the text starts with prefix."
    }
  ],
  "solution": "func solve(text, prefix):\n\treturn text.begins_with(prefix)",
  "generator": [
    {
      "pick": [
        "https://godotengine.org",
        "ftp://x",
        "abc"
      ]
    },
    {
      "pick": [
        "https",
        ""
      ]
    }
  ]
}
