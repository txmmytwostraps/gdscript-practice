{
  "id": "gqvec-005",
  "title": "Scale by a number",
  "concept": "gq-vectors",
  "difficulty": 0,
  "prompt": "Return the vector multiplied by factor; both parts get multiplied. (1, 2) times 3 is (3, 6).",
  "signature": "func solve(v, factor) -> Vector2:",
  "starter": "func solve(v, factor) -> Vector2:\n\treturn v",
  "tests": [
    {
      "name": "(1, 2) times 3 is (3, 6)",
      "args": [
        {
          "$v2": [
            1,
            2
          ]
        },
        3
      ],
      "expect": {
        "$v2": [
          3,
          6
        ]
      }
    },
    {
      "name": "(4, -2) times 0.5 is (2, -1)",
      "args": [
        {
          "$v2": [
            4,
            -2
          ]
        },
        0.5
      ],
      "expect": {
        "$v2": [
          2,
          -1
        ]
      }
    },
    {
      "name": "Times 0 is (0, 0)",
      "args": [
        {
          "$v2": [
            1,
            1
          ]
        },
        0
      ],
      "expect": {
        "$v2": [
          0,
          0
        ]
      }
    }
  ],
  "hints": [
    "A vector times a plain number is allowed with *.",
    "`return v * factor`"
  ],
  "docs": [
    {
      "name": "a + b, a - b, v * number, v / number",
      "what": "Vectors add and subtract part by part, and scale by a plain number."
    }
  ],
  "solution": "func solve(v, factor) -> Vector2:\n\treturn v * factor",
  "generator": [
    {
      "v2": [
        [
          1,
          6
        ],
        [
          -4,
          4
        ],
        0
      ]
    },
    {
      "float": [
        0,
        5,
        1
      ]
    }
  ]
}
