{
  "id": "gqarr-010",
  "title": "Where is it",
  "concept": "gq-arrays",
  "difficulty": 1,
  "prompt": "Return the position of value in the array, or -1 if it is not there. 7 in [5, 6, 7] is at position 2.",
  "signature": "func position_of(items, value):",
  "fn": "position_of",
  "starter": "func position_of(items, value):\n\treturn 0",
  "tests": [
    {
      "name": "7 is at position 2",
      "args": [
        [
          5,
          6,
          7
        ],
        7
      ],
      "expect": 2
    },
    {
      "name": "5 is at position 0",
      "args": [
        [
          5,
          6,
          7
        ],
        5
      ],
      "expect": 0
    },
    {
      "name": "Missing gives -1",
      "args": [
        [
          5,
          6,
          7
        ],
        9
      ],
      "expect": -1
    }
  ],
  "hints": [
    "Arrays have a find method that already returns -1 when nothing matches.",
    "`return items.find(value)`"
  ],
  "docs": [
    {
      "name": "list.find(value)",
      "what": "Returns the position of value, or -1 if it is not there."
    }
  ],
  "solution": "func position_of(items, value):\n\treturn items.find(value)",
  "generator": [
    {
      "array": {
        "len": [
          3,
          5
        ],
        "of": {
          "int": [
            3,
            9
          ]
        }
      }
    },
    {
      "int": [
        3,
        11
      ]
    }
  ]
}
