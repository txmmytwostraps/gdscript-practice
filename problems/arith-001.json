{
  "id": "arith-001",
  "title": "Room area",
  "concept": "arithmetic",
  "difficulty": 0,
  "prompt": "The robot measures a rectangular room. Return its area: width times height. solve(3, 4) is 12.",
  "signature": "func solve(width, height):",
  "starter": "func solve(width, height):\n\treturn 0",
  "tests": [
    {
      "name": "3 by 4 is 12",
      "args": [
        3,
        4
      ],
      "expect": 12
    },
    {
      "name": "5 by 5 is 25",
      "args": [
        5,
        5
      ],
      "expect": 25
    },
    {
      "name": "0 wide is 0",
      "args": [
        0,
        9
      ],
      "expect": 0
    },
    {
      "name": "7 by 1 is 7",
      "args": [
        7,
        1
      ],
      "expect": 7
    }
  ],
  "hints": [
    "Area is one side multiplied by the other.",
    "`return width * height`"
  ],
  "docs": [],
  "solution": "func solve(width, height):\n\treturn width * height"
}
