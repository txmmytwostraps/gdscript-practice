{
  "id": "dict-005",
  "title": "Keys with a value",
  "concept": "dictionaries",
  "difficulty": 1,
  "prompt": "Return an array of every key whose value equals value, in the order they appear in the dictionary.",
  "signature": "func keys_with_value(data, value):",
  "fn": "keys_with_value",
  "starter": "func keys_with_value(data, value):\n\treturn []",
  "tests": [
    {
      "name": "a and c hold 1",
      "args": [
        {
          "a": 1,
          "b": 2,
          "c": 1
        },
        1
      ],
      "expect": [
        "a",
        "c"
      ]
    },
    {
      "name": "No matches",
      "args": [
        {
          "a": 1
        },
        5
      ],
      "expect": []
    },
    {
      "name": "Both hold 0",
      "args": [
        {
          "x": 0,
          "y": 0
        },
        0
      ],
      "expect": [
        "x",
        "y"
      ]
    }
  ],
  "hints": [
    "Loop over the keys; append the ones whose value matches.",
    "`if data[key] == value:` then `result.append(key)`."
  ],
  "docs": [
    {
      "name": "for key in data:",
      "what": "Runs once per key; data[key] gives its value."
    }
  ],
  "solution": "func keys_with_value(data, value):\n\tvar result = []\n\tfor key in data:\n\t\tif data[key] == value:\n\t\t\tresult.append(key)\n\treturn result",
  "generator": [
    {
      "pick": [
        {
          "a": 1,
          "b": 2,
          "c": 1
        },
        {
          "a": 1
        },
        {
          "x": 0,
          "y": 0
        }
      ]
    },
    {
      "int": [
        0,
        8
      ]
    }
  ]
}
