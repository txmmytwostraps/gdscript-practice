{
  "id": "gqrect-002",
  "title": "Rect from position and size",
  "concept": "gq-rect",
  "difficulty": 0,
  "prompt": "Return a Rect2 from a position vector and a size vector.",
  "signature": "func solve(position, size) -> Rect2:",
  "starter": "func solve(position, size) -> Rect2:\n\treturn Rect2()",
  "tests": [
    {
      "name": "(10, 20) with size (30, 40)",
      "args": [
        {
          "$v2": [
            10,
            20
          ]
        },
        {
          "$v2": [
            30,
            40
          ]
        }
      ],
      "expect": {
        "$rect": [
          10,
          20,
          30,
          40
        ]
      }
    },
    {
      "name": "Negative position works",
      "args": [
        {
          "$v2": [
            -5,
            0
          ]
        },
        {
          "$v2": [
            5,
            5
          ]
        }
      ],
      "expect": {
        "$rect": [
          -5,
          0,
          5,
          5
        ]
      }
    }
  ],
  "hints": [
    "Rect2 also accepts two vectors.",
    "`return Rect2(position, size)`"
  ],
  "docs": [
    {
      "name": "Rect2(x, y, width, height)",
      "what": "Makes a rectangle from a top-left corner and a size. Also Rect2(position, size) with two vectors."
    }
  ],
  "solution": "func solve(position, size) -> Rect2:\n\treturn Rect2(position, size)",
  "generator": [
    {
      "v2": [
        [
          -13,
          18
        ],
        [
          0,
          30
        ],
        0
      ]
    },
    {
      "v2": [
        [
          1,
          43
        ],
        [
          1,
          58
        ],
        0
      ]
    }
  ]
}
