{
  "id": "gqarr-002",
  "title": "First item",
  "concept": "gq-arrays",
  "difficulty": 0,
  "prompt": "The robot's inventory has at least one item. Return the first one.",
  "signature": "func first_item(items):",
  "fn": "first_item",
  "starter": "func first_item(items):\n\treturn 0",
  "tests": [
    {
      "name": "First of 5, 6, 7 is 5",
      "args": [
        [
          5,
          6,
          7
        ]
      ],
      "expect": 5
    },
    {
      "name": "A single item",
      "args": [
        [
          42
        ]
      ],
      "expect": 42
    },
    {
      "name": "First can be negative",
      "args": [
        [
          -1,
          0
        ]
      ],
      "expect": -1
    }
  ],
  "hints": [
    "Positions in an array start at 0, not 1.",
    "`return items[0]`"
  ],
  "docs": [
    {
      "name": "list[i]",
      "what": "The item at position i. Positions start at 0; -1 is the last item."
    }
  ],
  "solution": "func first_item(items):\n\treturn items[0]",
  "generator": [
    {
      "array": {
        "len": [
          1,
          5
        ],
        "of": {
          "int": [
            -23,
            64
          ]
        }
      }
    }
  ]
}
