      "args": [
        "-5"
      ],
      "expect": -4
    }
  ],
  "hints": [
    "int() reads a number out of text.",
    "`return int(text) + 1`"
  ],
  "docs": [
    {
      "name": "int(value)",
      "what": "Returns the value as a whole number; decimals are dropped, text like \"42\" is read."
    }
  ],
  "solution": "func solve(text):\n\treturn int(text) + 1",
