  "title": "Text to a whole number",
  "concept": "gq-valuetypes",
  "difficulty": 0,
  "prompt": "The player typed their age as text. Return it as a whole number plus 1, so \"41\" gives 42.",
  "signature": "func solve(text):",
  "starter": "func solve(text):\n\treturn 0",
  "tests": [
    {
      "name": "41 becomes 42",
