{
  "id": "gqstr-017",
  "title": "Text to number",
  "concept": "gq-strings",
  "difficulty": 1,
  "prompt": "The text holds a whole number, like \"41\". Return that number plus one, as a number.",
  "signature": "func text_plus_one(text):",
  "fn": "text_plus_one",
  "starter": "func text_plus_one(text):\n\treturn 0",
  "tests": [
    {
      "name": "41 becomes 42",
      "args": [
        "41"
      ],
      "expect": 42
    },
    {
      "name": "0 becomes 1",
      "args": [
        "0"
      ],
      "expect": 1
    },
    {
      "name": "-5 becomes -4",
      "args": [
        "-5"
      ],
      "expect": -4
    }
  ],
  "hints": [
    "Strings have a to_int method; adding one to text would not work.",
    "`return text.to_int() + 1`"
  ],
  "docs": [
    {
      "name": "text.to_int()",
      "what": "Returns the whole number written in the text."
    }
  ],
  "solution": "func text_plus_one(text):\n\treturn text.to_int() + 1",
  "generator": [
    {
      "pick": [
        "41",
        "0",
        "-5"
      ]
    }
  ]
}
