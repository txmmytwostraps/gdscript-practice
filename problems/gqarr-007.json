{
  "id": "gqarr-007",
  "title": "Return two values in an array",
  "concept": "gq-arrays",
  "difficulty": 0,
  "prompt": "A function can only return one thing, so return an array holding two: a plus b, then a minus b. sum_and_difference(5, 3) is [8, 2].",
  "signature": "func sum_and_difference(a, b):",
  "fn": "sum_and_difference",
  "starter": "func sum_and_difference(a, b):\n\treturn []",
  "tests": [
    {
      "name": "5 and 3 give [8, 2]",
      "args": [
        5,
        3
      ],
      "expect": [
        8,
        2
      ]
    },
    {
      "name": "Zeros give [0, 0]",
      "args": [
        0,
        0
      ],
      "expect": [
        0,
        0
      ]
    },
    {
      "name": "1 and 4 give [5, -3]",
      "args": [
        1,
        4
      ],
      "expect": [
        5,
        -3
      ]
    }
  ],
  "hints": [
    "Calculations can go straight inside the square brackets.",
    "`return [a + b, a - b]`"
  ],
  "docs": [],
  "solution": "func sum_and_difference(a, b):\n\treturn [a + b, a - b]",
  "generator": [
    {
      "int": [
        0,
        8
      ]
    },
    {
      "int": [
        0,
        6
      ]
    }
  ]
}
