{
  "id": "gqrect-005",
  "title": "Center of a rect",
  "concept": "gq-rect",
  "difficulty": 0,
  "prompt": "Return the point in the middle of the rectangle.",
  "signature": "func rect_center(r) -> Vector2:",
  "fn": "rect_center",
  "starter": "func rect_center(r) -> Vector2:\n\treturn r.position",
  "tests": [
    {
      "name": "10 by 10 at origin centers at (5, 5)",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        }
      ],
      "expect": {
        "$v2": [
          5,
          5
        ]
      }
    },
    {
      "name": "(10, 20) 30 by 40 centers at (25, 40)",
      "args": [
        {
          "$rect": [
            10,
            20,
            30,
            40
          ]
        }
      ],
      "expect": {
        "$v2": [
          25,
          40
        ]
      }
    }
  ],
  "hints": [
    "Position plus half the size, or the method made for it.",
    "`return r.get_center()`"
  ],
  "docs": [
    {
      "name": "r.get_center()",
      "what": "Returns the middle point of the rectangle."
    }
  ],
  "solution": "func rect_center(r) -> Vector2:\n\treturn r.get_center()",
