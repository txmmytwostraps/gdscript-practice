{
  "id": "gqvec-011",
  "title": "Mirror left to right",
  "concept": "gq-vectors",
  "difficulty": 1,
  "prompt": "Return the vector flipped horizontally: x changes sign, y stays the same. (3, 4) becomes (-3, 4).",
  "signature": "func mirror_x(v) -> Vector2:",
  "fn": "mirror_x",
  "starter": "func mirror_x(v) -> Vector2:\n\treturn v",
  "tests": [
    {
      "name": "(3, 4) becomes (-3, 4)",
      "args": [
        {
          "$v2": [
            3,
            4
          ]
        }
      ],
      "expect": {
        "$v2": [
          -3,
          4
        ]
      }
    },
    {
      "name": "(-1, -1) becomes (1, -1)",
      "args": [
        {
          "$v2": [
            -1,
            -1
          ]
        }
      ],
      "expect": {
        "$v2": [
          1,
          -1
        ]
      }
    },
    {
      "name": "x of 0 stays 0",
      "args": [
        {
          "$v2": [
            0,
            2
          ]
        }
      ],
      "expect": {
        "$v2": [
          0,
          2
        ]
      }
    }
  ],
  "hints": [
    "Build a new Vector2 from the old parts, changing only one.",
    "`return Vector2(-v.x, v.y)`"
  ],
  "docs": [
    {
      "name": "Vector2(x, y)",
      "what": "Makes a vector holding an x and a y. Read them back with .x and .y."
    }
  ],
  "solution": "func mirror_x(v) -> Vector2:\n\treturn Vector2(-v.x, v.y)",
  "generator": [
    {
      "v2": [
        [
          -3,
          5
        ],
        [
          -4,
          7
        ],
        0
      ]
    }
  ]
}
