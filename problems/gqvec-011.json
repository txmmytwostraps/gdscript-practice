{
  "id": "gqvec-011",
  "title": "Mirror left to right",
  "concept": "gq-vectors",
  "difficulty": 1,
  "prompt": "Return the vector flipped horizontally: x changes sign, y stays the same.",
  "signature": "func solve(v: Vector2) -> Vector2:",
  "starter": "func solve(v: Vector2) -> Vector2:\n\treturn v",
  "tests": [
    {
      "args": [
        {
          "$v2": [
            3,
            4
          ]
        }
      ],
      "expect": {
        "$v2": [
          -3,
          4
        ]
      }
    },
    {
      "args": [
        {
          "$v2": [
            -1,
            -1
          ]
        }
      ],
      "expect": {
        "$v2": [
          1,
          -1
        ]
      }
    },
    {
      "args": [
        {
          "$v2": [
            0,
            2
          ]
        }
      ],
      "expect": {
        "$v2": [
          0,
          2
        ]
      }
    }
  ],
  "hint": "Build a new Vector2 from the old parts, changing only one of them.",
  "solution": "func solve(v: Vector2) -> Vector2:\n\treturn Vector2(-v.x, v.y)"
}
