{
  "id": "str-002",
  "title": "How long",
  "concept": "strings",
  "difficulty": 0,
  "prompt": "Return the number of characters in text.",
  "signature": "func solve(text: String) -> int:",
  "starter": "func solve(text: String) -> int:\n\treturn 0",
  "tests": [
