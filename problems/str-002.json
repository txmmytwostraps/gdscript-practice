    {
      "args": [
        "a b"
      ],
      "expect": 3
    },
    {
      "args": [
        "GDScript"
      ],
      "expect": 8
    }
  ],
  "hint": "Strings have a `length()` method: `text.length()`.",
  "solution": "func solve(text: String) -> int:\n\treturn text.length()"
