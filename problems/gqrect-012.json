{
  "id": "gqrect-012",
  "title": "The four edges",
  "concept": "gq-rect",
  "difficulty": 0,
  "prompt": "Return an array of the rectangle's left, top, right and bottom edge positions, in that order.",
  "signature": "func four_edges(r):",
  "fn": "four_edges",
  "starter": "func four_edges(r):\n\treturn []",
  "tests": [
    {
      "name": "(10, 20, 30, 40) gives 10, 20, 40, 60",
      "args": [
        {
          "$rect": [
            10,
            20,
            30,
            40
          ]
        }
      ],
      "expect": [
        10,
        20,
        40,
        60
      ]
    },
    {
      "name": "Unit square at origin",
      "args": [
        {
          "$rect": [
            0,
            0,
            5,
            5
          ]
        }
      ],
      "expect": [
        0,
        0,
        5,
        5
      ]
    }
  ],
  "hints": [
    "Left and top come from position; right and bottom from end.",
    "`return [r.position.x, r.position.y, r.end.x, r.end.y]`"
  ],
  "docs": [
    {
      "name": "r.position, r.size, r.end",
      "what": "The top-left corner, the width and height, and the bottom-right corner, all Vector2."
    }
  ],
  "solution": "func four_edges(r):\n\treturn [r.position.x, r.position.y, r.end.x, r.end.y]",
  "generator": [
    {
      "rect": [
        [
          0,
          15
        ],
        [
          0,
          30
        ],
        [
          1,
          43
        ],
        [
          1,
          58
        ]
      ]
    }
  ]
}
