{
  "id": "gqparam-012",
  "title": "Use the parameter twice",
  "concept": "gq-parameters",
  "difficulty": 0,
  "prompt": "A parameter can be used as many times as you like. Return n times n, plus n, so solve(3) is 12.",
  "signature": "func solve(n):",
  "starter": "func solve(n):\n\treturn n",
  "tests": [
    {
      "name": "3 gives 12",
      "args": [
        3
      ],
      "expect": 12
    },
    {
      "name": "0 gives 0",
      "args": [
        0
      ],
      "expect": 0
    },
    {
      "name": "1 gives 2",
      "args": [
        1
      ],
      "expect": 2
    },
    {
      "name": "5 gives 30",
      "args": [
        5
      ],
      "expect": 30
    }
  ],
  "hints": [
    "Three uses of n in one expression.",
    "`return n * n + n`"
  ],
  "docs": [],
  "solution": "func solve(n):\n\treturn n * n + n"
}
