{
  "id": "cmp-001",
  "title": "Old enough",
  "concept": "comparisons",
  "difficulty": 0,
  "prompt": "Return true if age is 18 or more, otherwise false.",
  "signature": "func solve(age):",
  "starter": "func solve(age):\n\treturn false",
  "tests": [
    {
      "name": "18 is old enough",
      "args": [
        18
      ],
      "expect": true
    },
    {
      "name": "17 is not",
      "args": [
        17
      ],
      "expect": false
    },
    {
      "name": "40 is",
      "args": [
        40
      ],
      "expect": true
    },
    {
      "name": "0 is not",
      "args": [
        0
      ],
      "expect": false
    }
  ],
  "hints": [
    "A comparison is already true or false, so you can return it directly.",
    "`return age >= 18`"
  ],
  "docs": [
    {
      "name": "==  !=  <  <=  >  >=",
      "what": "Comparisons. Each gives true or false."
    }
  ],
  "solution": "func solve(age):\n\treturn age >= 18"
}
