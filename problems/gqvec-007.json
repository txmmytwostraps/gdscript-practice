{
  "id": "gqvec-007",
  "title": "Distance between points",
  "concept": "gq-vectors",
  "difficulty": 1,
  "prompt": "Return the distance between the robot at a and the target at b. From (0, 0) to (3, 4) is 5.",
  "signature": "func distance_between(a, b) -> float:",
  "fn": "distance_between",
  "starter": "func distance_between(a, b) -> float:\n\treturn 0.0",
  "tests": [
    {
      "name": "(0, 0) to (3, 4) is 5",
      "args": [
        {
          "$v2": [
            0,
            0
          ]
        },
        {
          "$v2": [
            3,
            4
          ]
        }
      ],
      "expect": 5
    },
    {
      "name": "Same point is 0",
      "args": [
        {
          "$v2": [
            1,
            1
          ]
        },
        {
          "$v2": [
            1,
            1
          ]
        }
      ],
      "expect": 0
    },
    {
      "name": "(-1, 0) to (2, 4) is 5",
      "args": [
        {
          "$v2": [
            -1,
            0
          ]
        },
        {
          "$v2": [
            2,
            4
          ]
        }
      ],
      "expect": 5
    }
  ],
  "hints": [
    "Either take the length of the vector from a to b, or use the method made for it.",
    "`return a.distance_to(b)`"
  ],
  "docs": [
    {
      "name": "a.distance_to(b)",
      "what": "Returns the distance between two points."
    },
    {
      "name": "v.length()",
      "what": "Returns the length of the vector as a float."
    }
  ],
  "solution": "func distance_between(a, b) -> float:\n\treturn a.distance_to(b)",
  "generator": [
    {
      "v2": [
        [
          -3,
          3
        ],
        [
          0,
          3
        ],
        0
      ]
    },
    {
      "v2": [
        [
          1,
          5
        ],
        [
          1,
          6
        ],
        0
      ]
    }
  ]
}
