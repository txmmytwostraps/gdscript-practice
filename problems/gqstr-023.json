{
  "id": "gqstr-023",
  "title": "Part of a string",
  "concept": "gq-strings",
  "difficulty": 1,
  "prompt": "Return the first three characters of the text. If it is shorter than three, return all of it.",
  "signature": "func first_three(text):",
  "fn": "first_three",
  "starter": "func first_three(text):\n\treturn text",
  "tests": [
    {
      "name": "Godot gives God",
      "args": [
        "Godot"
      ],
      "expect": "God"
    },
    {
      "name": "hi is short enough",
      "args": [
        "hi"
      ],
      "expect": "hi"
    },
    {
      "name": "abcdef gives abc",
      "args": [
        "abcdef"
      ],
      "expect": "abc"
    }
  ],
  "hints": [
    "substr takes a start position and a length, and is happy to stop early.",
    "`return text.substr(0, 3)`"
  ],
  "docs": [
    {
      "name": "text.substr(start, length)",
      "what": "Returns part of the text, starting at position start, at most length characters."
    }
  ],
  "solution": "func first_three(text):\n\treturn text.substr(0, 3)",
  "generator": [
    {
      "pick": [
        "Godot",
        "hi",
        "abcdef"
      ]
    }
  ]
}
