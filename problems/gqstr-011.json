{
  "id": "gqstr-011",
  "title": "Split into words",
  "concept": "gq-strings",
  "difficulty": 1,
  "prompt": "Return an array of the words in the text, which are separated by single spaces.",
  "signature": "func split_words(text):",
  "fn": "split_words",
  "starter": "func split_words(text):\n\treturn [text]",
  "tests": [
    {
      "name": "Three words",
      "args": [
        "one two three"
      ],
      "expect": [
        "one",
        "two",
        "three"
      ]
    },
    {
      "name": "One word",
      "args": [
        "solo"
      ],
      "expect": [
        "solo"
      ]
    }
  ],
  "hints": [
    "split takes the separator and gives back the pieces.",
    "`return text.split(\" \")`"
  ],
  "docs": [
    {
      "name": "text.split(separator)",
      "what": "Returns an array of the pieces between each separator."
    }
  ],
  "solution": "func split_words(text):\n\treturn text.split(\" \")",
  "generator": [
    {
      "pick": [
        "one two three",
        "solo"
      ]
    }
  ]
}
