{
  "id": "gqla-013",
  "title": "Is it there",
  "concept": "gq-looparrays",
  "difficulty": 0,
  "prompt": "Return true if target is in the array, using a loop rather than the in keyword.",
  "signature": "func is_in_array(items, target):",
  "fn": "is_in_array",
  "starter": "func is_in_array(items, target):\n\treturn false",
  "tests": [
    {
      "name": "2 is in [1, 2, 3]",
      "args": [
        [
          1,
          2,
          3
        ],
        2
      ],
      "expect": true
    },
    {
      "name": "5 is not",
      "args": [
        [
          1,
          2,
          3
        ],
        5
      ],
      "expect": false
    },
    {
      "name": "Empty has nothing",
      "args": [
        [],
        1
      ],
      "expect": false
    }
  ],
  "hints": [
    "Start with false; switch to true when you see a match.",
    "`if item == target:` then `found = true`."
  ],
  "docs": [
    {
      "name": "for item in list:",
      "what": "Runs the indented lines once per item, with item holding each value in turn."
    }
  ],
  "solution": "func is_in_array(items, target):\n\tvar found = false\n\tfor item in items:\n\t\tif item == target:\n\t\t\tfound = true\n\treturn found",
  "generator": [
    {
      "array": {
        "len": [
          0,
          5
        ],
        "of": {
          "int": [
            1,
            5
          ]
        }
      }
    },
    {
      "int": [
        1,
        7
      ]
    }
  ]
}
