{
  "id": "gqrect-011",
  "title": "Do they overlap",
  "concept": "gq-rect",
  "difficulty": 1,
  "prompt": "Return true if the two rectangles overlap. This is how simple games spot collisions. Touching edges do not count.",
  "signature": "func solve(a, b):",
  "starter": "func solve(a, b):\n\treturn false",
  "tests": [
    {
      "name": "Overlapping squares",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        },
        {
          "$rect": [
            5,
            5,
            10,
            10
          ]
        }
      ],
      "expect": true
    },
    {
      "name": "Far apart",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        },
        {
          "$rect": [
            20,
            20,
            5,
            5
          ]
        }
      ],
      "expect": false
    },
    {
      "name": "Edge to edge is not overlap",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        },
        {
          "$rect": [
            10,
            0,
            5,
            5
          ]
        }
      ],
      "expect": false
    }
  ],
  "hints": [
    "Look for a method whose name means to cross or overlap.",
    "`return a.intersects(b)`"
  ],
  "docs": [
    {
      "name": "a.intersects(b)",
      "what": "Returns true if the two rectangles overlap."
    }
  ],
  "solution": "func solve(a, b):\n\treturn a.intersects(b)",
  "generator": [
    {
      "rect": [
        [
          0,
          2
        ],
        [
          0,
          2
        ],
        [
          8,
          12
        ],
        [
          8,
          12
        ]
      ]
    },
    {
      "rect": [
        [
          1,
          28
        ],
        [
          0,
          30
        ],
        [
          2,
          13
        ],
        [
          2,
          13
        ]
      ]
    }
  ]
}
