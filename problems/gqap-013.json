{
  "id": "gqap-013",
  "title": "Serve two, keep the rest",
  "concept": "gq-appendpop",
  "difficulty": 1,
  "prompt": "The robot serves the first two orders. serve_two gives back what is still waiting; there are always at least two orders.",
  "signature": "func serve_two(queue):",
  "fn": "serve_two",
  "starter": "func serve_two(queue):\n\treturn queue",
  "tests": [
    {
      "name": "Two served, one left",
      "args": [
        [
          "soup",
          "pie",
          "tea"
        ]
      ],
      "expect": [
        "tea"
      ]
    },
    {
      "name": "Two served, none left",
      "args": [
        [
          "a",
          "b"
        ]
      ],
      "expect": []
    }
  ],
  "hints": [
    "pop_front takes the first order; two calls, then return the queue.",
    "`queue.pop_front()` twice, then `return queue`."
  ],
  "docs": [
    {
      "name": "list.pop_front()",
      "what": "Removes the first item and returns it."
    }
  ],
  "solution": "func serve_two(queue):\n\tqueue.pop_front()\n\tqueue.pop_front()\n\treturn queue",
  "generator": [
    {
      "array": {
        "len": [
          2,
          5
        ],
        "of": {
          "pick": [
            "soup",
            "pie",
            "tea",
            "a",
            "b"
          ]
        }
      }
    }
  ]
}
