{
  "id": "gqrect-008",
  "title": "Grow",
  "concept": "gq-rect",
  "difficulty": 1,
  "prompt": "Return the rectangle made bigger by margin on every side, so it stays centred where it was. Growing (10, 10, 20, 20) by 5 gives (5, 5, 30, 30).",
  "signature": "func solve(r, margin) -> Rect2:",
  "starter": "func solve(r, margin) -> Rect2:\n\treturn r",
  "tests": [
    {
      "name": "Grow by 5",
      "args": [
        {
          "$rect": [
            10,
            10,
            20,
            20
          ]
        },
        5
      ],
      "expect": {
        "$rect": [
          5,
          5,
          30,
          30
        ]
      }
    },
    {
      "name": "Grow by 0 is unchanged",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        },
        0
      ],
      "expect": {
        "$rect": [
          0,
          0,
          10,
          10
        ]
      }
    }
  ],
  "hints": [
    "Rect2 has a grow method.",
    "`return r.grow(margin)`"
  ],
  "docs": [
    {
      "name": "r.grow(amount)",
      "what": "Returns the rectangle made bigger by amount on every side (negative shrinks)."
    }
  ],
  "solution": "func solve(r, margin) -> Rect2:\n\treturn r.grow(margin)",
  "generator": [
    {
      "rect": [
        [
          0,
          15
        ],
        [
          0,
          15
        ],
        [
          5,
          25
        ],
        [
          5,
          25
        ]
      ]
    },
    {
      "int": [
        0,
        8
      ]
    }
  ]
}
