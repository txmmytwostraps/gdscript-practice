{
  "id": "gqrect-003",
  "title": "Area of a rect",
  "concept": "gq-rect",
  "difficulty": 0,
  "prompt": "Return the area of the rectangle: its width times its height.",
  "signature": "func rect_area(r) -> float:",
  "fn": "rect_area",
  "starter": "func rect_area(r) -> float:\n\treturn 0.0",
  "tests": [
    {
      "name": "3 by 4 is 12",
      "args": [
        {
          "$rect": [
            0,
            0,
            3,
            4
          ]
        }
      ],
      "expect": 12
    },
    {
      "name": "2.5 by 2 is 5",
      "args": [
        {
          "$rect": [
            10,
            10,
            2.5,
            2
          ]
        }
      ],
      "expect": 5
    },
    {
      "name": "Zero width is 0",
      "args": [
        {
          "$rect": [
            0,
            0,
            0,
            9
          ]
        }
      ],
      "expect": 0
    }
  ],
  "hints": [
    "The width and height live inside r.size.",
    "`return r.size.x * r.size.y`"
  ],
  "docs": [
    {
      "name": "r.position, r.size, r.end",
      "what": "The top-left corner, the width and height, and the bottom-right corner, all Vector2."
    }
  ],
  "solution": "func rect_area(r) -> float:\n\treturn r.size.x * r.size.y",
  "generator": [
    {
      "rect": [
        [
          0,
          15
        ],
        [
          0,
          15
        ],
        [
          0,
          5
        ],
        [
          1,
          13
        ]
      ]
    }
  ]
}
