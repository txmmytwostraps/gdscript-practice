{
  "id": "gqstr-006",
  "title": "Repeat, now with repeat()",
  "concept": "gq-strings",
  "difficulty": 0,
  "prompt": "Same task, using the built-in repeat method on the string.",
  "signature": "func solve(text, times):",
  "starter": "func solve(text, times):\n\treturn text",
  "tests": [
    {
      "name": "ab three times",
      "args": [
        "ab",
        3
      ],
      "expect": "ababab"
    },
    {
      "name": "Zero times is empty",
      "args": [
        "x",
        0
      ],
      "expect": ""
    },
    {
      "name": "Once is unchanged",
      "args": [
        "go",
        1
      ],
      "expect": "go"
    }
  ],
  "hints": [
    "One call, one argument: how many times.",
    "`return text.repeat(times)`"
  ],
  "docs": [
    {
      "name": "text.repeat(n)",
      "what": "Returns the text repeated n times."
    }
  ],
  "solution": "func solve(text, times):\n\treturn text.repeat(times)",
  "generator": [
    {
      "pick": [
        "ab",
        "x",
        "go"
      ]
    },
    {
      "int": [
        0,
        5
      ]
    }
  ]
}
