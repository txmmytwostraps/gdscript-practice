{
  "id": "cmp-002",
  "title": "Not the same",
  "concept": "comparisons",
  "difficulty": 0,
  "prompt": "Return true if a and b are different numbers, false if they are the same.",
  "signature": "func solve(a, b):",
  "starter": "func solve(a, b):\n\treturn false",
  "tests": [
    {
      "name": "1 and 2 differ",
      "args": [
        1,
        2
      ],
      "expect": true
    },
    {
      "name": "3 and 3 are the same",
      "args": [
        3,
        3
      ],
      "expect": false
    },
    {
      "name": "0 and 0 are the same",
      "args": [
        0,
        0
      ],
      "expect": false
    },
    {
      "name": "-1 and 1 differ",
      "args": [
        -1,
        1
      ],
      "expect": true
    }
  ],
  "hints": [
    "Not equal is written !=.",
    "`return a != b`"
  ],
  "docs": [
    {
      "name": "==  !=  <  <=  >  >=",
      "what": "Comparisons. Each gives true or false."
    }
  ],
  "solution": "func solve(a, b):\n\treturn a != b",
  "generator": [
