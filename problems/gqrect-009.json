{
  "id": "gqrect-009",
  "title": "Shrink",
  "concept": "gq-rect",
  "difficulty": 1,
  "prompt": "Return the rectangle made smaller by margin on every side.",
  "signature": "func solve(r, margin) -> Rect2:",
  "starter": "func solve(r, margin) -> Rect2:\n\treturn r",
  "tests": [
    {
      "name": "Shrink by 5",
      "args": [
        {
          "$rect": [
            5,
            5,
            30,
            30
          ]
        },
        5
      ],
      "expect": {
        "$rect": [
          10,
          10,
          20,
          20
        ]
      }
    },
    {
      "name": "Shrink by 1",
      "args": [
        {
          "$rect": [
            0,
            0,
            10,
            10
          ]
        },
        1
      ],
      "expect": {
        "$rect": [
          1,
          1,
          8,
          8
        ]
      }
    }
  ],
  "hints": [
    "Growing by a negative amount shrinks.",
    "`return r.grow(-margin)`"
  ],
  "docs": [
    {
      "name": "r.grow(amount)",
      "what": "Returns the rectangle made bigger by amount on every side (negative shrinks)."
    }
  ],
  "solution": "func solve(r, margin) -> Rect2:\n\treturn r.grow(-margin)"
}
