{
  "id": "gqvec-006",
  "title": "Length",
  "concept": "gq-vectors",
  "difficulty": 0,
  "prompt": "Return how long the vector is: the straight-line distance from (0, 0) to its tip. (3, 4) has length 5.",
  "signature": "func vector_length(v) -> float:",
  "fn": "vector_length",
  "starter": "func vector_length(v) -> float:\n\treturn v.x + v.y",
  "tests": [
    {
      "name": "(3, 4) is 5 long",
      "args": [
        {
          "$v2": [
            3,
            4
          ]
        }
      ],
      "expect": 5
    },
    {
      "name": "(0, 0) is 0 long",
      "args": [
        {
          "$v2": [
            0,
            0
          ]
        }
      ],
      "expect": 0
    },
    {
      "name": "(0, -7) is 7 long",
      "args": [
        {
          "$v2": [
            0,
            -7
          ]
        }
      ],
      "expect": 7
    }
  ],
  "hints": [
    "Vectors have a length method; no square-root formula needed.",
    "`return v.length()`"
  ],
  "docs": [
    {
      "name": "v.length()",
      "what": "Returns the length of the vector as a float."
    }
  ],
  "solution": "func vector_length(v) -> float:\n\treturn v.length()",
  "generator": [
    {
      "v2": [
        [
          0,
          5
        ],
        [
          -13,
          10
        ],
        0
      ]
    }
  ]
}
