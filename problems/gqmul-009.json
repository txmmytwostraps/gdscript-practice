{
  "id": "gqmul-009",
  "title": "Grow by ten percent",
  "concept": "gq-multiply",
  "difficulty": 1,
  "prompt": "Each level, max_health grows by 10%. Return max_health times 1.1. solve(100) is 110.0.",
  "signature": "func solve(max_health) -> float:",
  "starter": "func solve(max_health) -> float:\n\treturn max_health + 10",
  "tests": [
    {
      "name": "100 grows to 110",
      "args": [
        100
      ],
      "expect": 110
    },
    {
      "name": "200 grows to 220",
      "args": [
        200
      ],
      "expect": 220
    },
    {
      "name": "0 stays 0",
      "args": [
        0
      ],
      "expect": 0
    }
  ],
  "hints": [
    "Adding 10 is not the same as adding 10%.",
    "`return max_health * 1.1`"
  ],
  "docs": [
    {
      "name": "a * b",
      "what": "Multiplies two numbers. * with a float keeps decimals."
    }
  ],
  "solution": "func solve(max_health) -> float:\n\treturn max_health * 1.1"
}
