{
  "id": "gqarr-016",
  "title": "Largest, now with max()",
  "concept": "gq-arrays",
  "difficulty": 0,
  "prompt": "Same task: the largest number in the array. This time use the array's built-in max method.",
  "signature": "func largest_with_max(nums):",
  "fn": "largest_with_max",
  "starter": "func largest_with_max(nums):\n\treturn nums[0]",
  "tests": [
    {
      "name": "9 is largest",
      "args": [
        [
          3,
          9,
          2
        ]
      ],
      "expect": 9
    },
    {
      "name": "-1 is largest of negatives",
      "args": [
        [
          -5,
          -1,
          -9
        ]
      ],
      "expect": -1
    },
    {
      "name": "One item",
      "args": [
        [
          7
        ]
      ],
      "expect": 7
    }
  ],
  "hints": [
    "It is a method on the array, called with no arguments.",
    "`return nums.max()`"
  ],
  "docs": [
    {
      "name": "list.max()",
      "what": "Returns the largest item."
    }
  ],
  "solution": "func largest_with_max(nums):\n\treturn nums.max()",
  "generator": [
    {
      "array": {
        "len": [
          1,
          5
        ],
        "of": {
          "int": [
            -18,
            18
          ]
        }
      }
    }
  ]
}
