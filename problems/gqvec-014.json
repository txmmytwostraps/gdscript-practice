{
  "id": "gqvec-014",
  "title": "Vector to array",
  "concept": "gq-vectors",
  "difficulty": 0,
  "prompt": "Return an array holding the x part and then the y part of the vector. (3, 4) becomes [3, 4].",
  "signature": "func solve(v):",
  "starter": "func solve(v):\n\treturn []",
  "tests": [
    {
      "name": "(3, 4) becomes [3, 4]",
      "args": [
        {
          "$v2": [
            3,
            4
          ]
        }
      ],
      "expect": [
        3,
        4
      ]
    },
    {
      "name": "Decimals kept",
      "args": [
        {
          "$v2": [
            -1,
            0.5
          ]
        }
      ],
      "expect": [
        -1,
        0.5
      ]
    }
  ],
  "hints": [
    "Two values, square brackets.",
    "`return [v.x, v.y]`"
  ],
  "docs": [
    {
      "name": "Vector2(x, y)",
      "what": "Makes a vector holding an x and a y. Read them back with .x and .y."
    }
  ],
  "solution": "func solve(v):\n\treturn [v.x, v.y]",
  "generator": [
    {
      "v2": [
        [
          -3,
          5
        ],
        [
          1,
          6
        ],
        1
      ]
    }
  ]
}
