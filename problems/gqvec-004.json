{
  "id": "gqvec-004",
  "title": "From a to b",
  "concept": "gq-vectors",
  "difficulty": 1,
  "prompt": "Return the vector that takes the robot from point a to point b. Starting at a and adding your answer should land on b. The starter has the subtraction backwards.",
  "signature": "func from_a_to_b(a, b) -> Vector2:",
  "fn": "from_a_to_b",
  "starter": "func from_a_to_b(a, b) -> Vector2:\n\treturn a - b",
  "tests": [
    {
      "name": "(1, 1) to (4, 5) is (3, 4)",
      "args": [
        {
          "$v2": [
            1,
            1
          ]
        },
        {
          "$v2": [
            4,
            5
          ]
        }
      ],
      "expect": {
        "$v2": [
          3,
          4
        ]
      }
    },
    {
      "name": "Same point is (0, 0)",
      "args": [
        {
          "$v2": [
            5,
            5
          ]
        },
        {
          "$v2": [
            5,
            5
          ]
        }
      ],
      "expect": {
        "$v2": [
          0,
          0
        ]
      }
    },
    {
      "name": "(2, 0) to (0, 2) is (-2, 2)",
      "args": [
        {
          "$v2": [
            2,
            0
          ]
        },
        {
          "$v2": [
            0,
            2
          ]
        }
      ],
      "expect": {
        "$v2": [
          -2,
          2
        ]
      }
    }
  ],
  "hints": [
    "Destination minus start.",
    "`return b - a`"
  ],
  "docs": [
    {
      "name": "a + b, a - b, v * number, v / number",
      "what": "Vectors add and subtract part by part, and scale by a plain number."
    }
  ],
  "solution": "func from_a_to_b(a, b) -> Vector2:\n\treturn b - a",
  "generator": [
    {
      "v2": [
        [
          1,
          7
        ],
        [
          0,
          8
        ],
        0
      ]
    },
    {
      "v2": [
        [
          0,
          8
        ],
        [
          1,
          7
        ],
        0
      ]
    }
  ]
}
