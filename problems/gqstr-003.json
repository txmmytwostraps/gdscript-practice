{
  "id": "gqstr-003",
  "title": "Length",
  "concept": "gq-strings",
  "difficulty": 0,
  "prompt": "Return the number of characters in the text. Spaces count.",
  "signature": "func length_of(text):",
  "fn": "length_of",
  "starter": "func length_of(text):\n\treturn 0",
  "tests": [
    {
      "name": "hello is 5",
      "args": [
        "hello"
      ],
      "expect": 5
    },
    {
      "name": "Empty is 0",
      "args": [
        ""
      ],
      "expect": 0
    },
    {
      "name": "The space counts",
      "args": [
        "a b"
      ],
      "expect": 3
    }
  ],
  "hints": [
    "Strings have a length method, much like arrays have size.",
    "`return text.length()`"
  ],
  "docs": [
    {
      "name": "text.length()",
      "what": "Returns how many characters the string has."
    }
  ],
  "solution": "func length_of(text):\n\treturn text.length()",
  "generator": [
    {
      "pick": [
        "hello",
        "",
        "a b"
      ]
    }
  ]
}
