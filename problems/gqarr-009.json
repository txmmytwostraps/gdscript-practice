{
  "id": "gqarr-009",
  "title": "Contains",
  "concept": "gq-arrays",
  "difficulty": 0,
  "prompt": "Return true if value is somewhere in the array.",
  "signature": "func solve(items, value):",
  "starter": "func solve(items, value):\n\treturn false",
  "tests": [
    {
      "name": "2 is in [1, 2, 3]",
      "args": [
        [
          1,
          2,
          3
        ],
        2
      ],
      "expect": true
    },
    {
      "name": "5 is not",
      "args": [
        [
          1,
          2,
          3
        ],
        5
      ],
      "expect": false
    },
    {
      "name": "Nothing is in an empty array",
      "args": [
        [],
        1
      ],
      "expect": false
    }
  ],
  "hints": [
    "The word in works on arrays.",
    "`return value in items`"
  ],
  "docs": [
    {
      "name": "value in list",
      "what": "true if value is one of the items."
    }
  ],
  "solution": "func solve(items, value):\n\treturn value in items"
}
