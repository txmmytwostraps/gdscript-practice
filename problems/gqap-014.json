{
  "id": "gqap-014",
  "title": "Move the top crate",
  "concept": "gq-appendpop",
  "difficulty": 1,
  "prompt": "The robot moves the top crate from pile a onto pile b. move_top_crate gives back pile b with the crate on top.",
  "signature": "func move_top_crate(a, b):",
  "fn": "move_top_crate",
  "starter": "func move_top_crate(a, b):\n\treturn b",
  "tests": [
    {
      "name": "3 moves from a to b",
      "args": [
        [
          1,
          2,
          3
        ],
        [
          9
        ]
      ],
      "expect": [
        9,
        3
      ]
    },
    {
      "name": "Onto an empty pile",
      "args": [
        [
          5
        ],
        []
      ],
      "expect": [
        5
      ]
    }
  ],
  "hints": [
    "pop_back on a gives you the crate; append puts it down on b.",
    "`b.append(a.pop_back())`"
  ],
  "docs": [
    {
      "name": "list.pop_back()",
      "what": "Removes the last item and returns it."
    },
    {
      "name": "list.append(value)",
      "what": "Adds value to the end of the array. Returns nothing."
    }
  ],
  "solution": "func move_top_crate(a, b):\n\tb.append(a.pop_back())\n\treturn b",
  "generator": [
    {
      "array": {
        "len": [
          1,
          5
        ],
        "of": {
          "int": [
            1,
            7
          ]
        }
      }
    },
    {
      "array": {
        "len": [
          0,
          3
        ],
        "of": {
          "int": [
            7,
            11
          ]
        }
      }
    }
  ]
}
