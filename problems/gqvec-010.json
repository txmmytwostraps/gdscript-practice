{
  "id": "gqvec-010",
  "title": "Midpoint",
  "concept": "gq-vectors",
  "difficulty": 1,
  "prompt": "Return the point exactly halfway between a and b. Between (0, 0) and (4, 6) is (2, 3).",
  "signature": "func solve(a, b) -> Vector2:",
  "starter": "func solve(a, b) -> Vector2:\n\treturn a",
  "tests": [
    {
      "name": "(0, 0) and (4, 6) give (2, 3)",
      "args": [
        {
          "$v2": [
            0,
            0
          ]
        },
        {
          "$v2": [
            4,
            6
          ]
        }
      ],
      "expect": {
        "$v2": [
          2,
          3
        ]
      }
    },
    {
      "name": "Opposites give (0, 0)",
      "args": [
        {
          "$v2": [
            -2,
            -2
          ]
        },
        {
          "$v2": [
            2,
            2
          ]
        }
      ],
      "expect": {
        "$v2": [
          0,
          0
        ]
      }
    },
    {
      "name": "(1, 0) and (2, 0) give (1.5, 0)",
      "args": [
        {
          "$v2": [
            1,
            0
          ]
        },
        {
          "$v2": [
            2,
            0
          ]
        }
      ],
      "expect": {
        "$v2": [
          1.5,
          0
        ]
      }
    }
  ],
  "hints": [
    "Add them, then halve the result.",
    "`return (a + b) / 2`"
  ],
  "docs": [
    {
      "name": "a + b, a - b, v * number, v / number",
      "what": "Vectors add and subtract part by part, and scale by a plain number."
    }
  ],
  "solution": "func solve(a, b) -> Vector2:\n\treturn (a + b) / 2"
}
