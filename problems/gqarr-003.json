{
  "id": "gqarr-003",
  "title": "Last item",
  "concept": "gq-arrays",
  "difficulty": 0,
  "prompt": "Return the last item of the array. It always has at least one item.",
  "signature": "func last_item(items):",
  "fn": "last_item",
  "starter": "func last_item(items):\n\treturn items[0]",
  "tests": [
    {
      "name": "Last of 5, 6, 7 is 7",
      "args": [
        [
          5,
          6,
          7
        ]
      ],
      "expect": 7
    },
    {
      "name": "A single item",
      "args": [
        [
          42
        ]
      ],
      "expect": 42
    },
    {
      "name": "Last of five",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ]
      ],
      "expect": 5
    }
  ],
  "hints": [
    "The last position is one less than the size, or count from the end with -1.",
    "`return items[items.size() - 1]` or `return items[-1]`"
  ],
  "docs": [
    {
      "name": "list[i]",
      "what": "The item at position i. Positions start at 0; -1 is the last item."
    },
    {
      "name": "list.size()",
      "what": "Returns how many items the array holds."
    }
  ],
  "solution": "func last_item(items):\n\treturn items[items.size() - 1]",
  "generator": [
    {
      "array": {
        "len": [
          1,
          7
        ],
        "of": {
          "int": [
            1,
            63
          ]
        }
      }
    }
  ]
}
