{
  "id": "gqarr-004",
  "title": "How many",
  "concept": "gq-arrays",
  "difficulty": 0,
  "prompt": "Return how many items are in the robot's inventory.",
  "signature": "func how_many(items):",
  "fn": "how_many",
  "starter": "func how_many(items):\n\treturn 0",
  "tests": [
    {
      "name": "Three items",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expect": 3
    },
    {
      "name": "Empty is 0",
      "args": [
        []
      ],
      "expect": 0
    },
    {
      "name": "One item",
      "args": [
        [
          9
        ]
      ],
      "expect": 1
    }
  ],
  "hints": [
    "Arrays have a method that tells you their size.",
    "`return items.size()`"
  ],
  "docs": [
    {
      "name": "list.size()",
      "what": "Returns how many items the array holds."
    }
  ],
  "solution": "func how_many(items):\n\treturn items.size()",
  "generator": [
    {
      "array": {
        "len": [
          0,
          5
        ],
        "of": {
          "int": [
            1,
            13
          ]
        }
      }
    }
  ]
}
