{
  "id": "gqidx-006",
  "title": "First plus last",
  "concept": "gq-indices",
  "difficulty": 0,
  "prompt": "Return the first number plus the last number in the array.",
  "signature": "func first_plus_last(nums):",
  "fn": "first_plus_last",
  "starter": "func first_plus_last(nums):\n\treturn 0",
  "tests": [
    {
      "name": "1 plus 4 is 5",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expect": 5
    },
    {
      "name": "Single item counts twice",
      "args": [
        [
          7
        ]
      ],
      "expect": 14
    },
    {
      "name": "Negative ends",
      "args": [
        [
          -2,
          0,
          2
        ]
      ],
      "expect": 0
    }
  ],
  "hints": [
    "Position 0 and position -1.",
    "`return nums[0] + nums[-1]`"
  ],
  "docs": [
    {
      "name": "list[i]",
      "what": "The item at position i. Positions start at 0; -1 is the last item."
    }
  ],
  "solution": "func first_plus_last(nums):\n\treturn nums[0] + nums[-1]",
  "generator": [
    {
      "array": {
        "len": [
          1,
          6
        ],
        "of": {
          "int": [
            -7,
            12
          ]
        }
      }
    }
  ]
}
