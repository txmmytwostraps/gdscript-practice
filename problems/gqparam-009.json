{
  "id": "gqparam-009",
  "title": "Add two numbers",
  "concept": "gq-parameters",
  "difficulty": 0,
  "prompt": "`add_two` receives two numbers, a and b. Return them added together, so add_two(1, 2) is 3.",
  "signature": "func add_two(a, b):",
  "fn": "add_two",
  "starter": "func add_two(a, b):\n\treturn 0",
  "tests": [
    {
      "name": "1 plus 2 is 3",
      "args": [
        1,
        2
      ],
      "expect": 3
    },
    {
      "name": "Zeros give 0",
      "args": [
        0,
        0
      ],
      "expect": 0
    },
    {
      "name": "Negatives cancel",
      "args": [
        -5,
        5
      ],
      "expect": 0
    },
    {
      "name": "10 plus 20 is 30",
      "args": [
        10,
        20
      ],
      "expect": 30
    }
  ],
  "hints": [
    "Inside the function, a and b are ready to use like any variable.",
    "`return a + b`"
  ],
  "docs": [],
  "solution": "func add_two(a, b):\n\treturn a + b",
  "generator": [
    {
      "int": [
        -13,
        18
      ]
    },
    {
      "int": [
        0,
        30
      ]
    }
  ]
}
