{
  "id": "gqvec-002",
  "title": "Read x and y",
  "concept": "gq-vectors",
  "difficulty": 0,
  "prompt": "Return the x part of the vector added to its y part.",
  "signature": "func solve(v: Vector2) -> float:",
  "starter": "func solve(v: Vector2) -> float:\n\treturn 0.0",
  "tests": [
    {
      "args": [
        {
          "$v2": [
            3,
            4
          ]
        }
      ],
      "expect": 7
    },
    {
      "args": [
        {
          "$v2": [
            -2,
            2
          ]
        }
      ],
      "expect": 0
    },
    {
      "args": [
        {
          "$v2": [
            0.5,
            0.25
          ]
        }
      ],
      "expect": 0.75
    }
  ],
  "hint": "The two parts are reached with a dot: v.x and v.y.",
  "solution": "func solve(v: Vector2) -> float:\n\treturn v.x + v.y"
}
