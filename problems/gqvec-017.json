{
  "id": "gqvec-017",
  "title": "Standing still",
  "concept": "gq-vectors",
  "difficulty": 0,
  "prompt": "Return true if the robot's velocity is exactly zero in both parts.",
  "signature": "func is_standing_still(velocity):",
  "fn": "is_standing_still",
  "starter": "func is_standing_still(velocity):\n\treturn false",
  "tests": [
    {
      "name": "(0, 0) is still",
      "args": [
        {
          "$v2": [
            0,
            0
          ]
        }
      ],
      "expect": true
    },
    {
      "name": "(0, 1) is moving",
      "args": [
        {
          "$v2": [
            0,
            1
          ]
        }
      ],
      "expect": false
    },
    {
      "name": "A tiny x is moving",
      "args": [
        {
          "$v2": [
            -0.1,
            0
          ]
        }
      ],
      "expect": false
    }
  ],
  "hints": [
    "Vectors can be compared with ==.",
    "`return velocity == Vector2.ZERO`"
  ],
  "docs": [
    {
      "name": "Vector2.UP, DOWN, LEFT, RIGHT, ZERO",
      "what": "Ready-made vectors. UP is (0, -1) because y grows downward on screen."
    }
  ],
  "solution": "func is_standing_still(velocity):\n\treturn velocity == Vector2.ZERO",
  "generator": [
    {
      "v2": [
        [
          -2.1,
          2
        ],
        [
          0,
          3
        ],
        1
      ]
    }
  ]
}
