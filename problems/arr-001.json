{
  "id": "arr-001",
  "title": "First and last",
  "concept": "arrays",
  "difficulty": 0,
  "prompt": "Return an array holding the first item and the last item of items, in that order. The array always has at least one item.",
  "signature": "func solve(items):",
  "starter": "func solve(items):\n\treturn []",
  "tests": [
    {
      "name": "[1, 2, 3] gives [1, 3]",
      "args": [
