{
  "id": "arr-001",
  "title": "First and last",
  "concept": "arrays",
  "difficulty": 0,
  "prompt": "Return an array holding the first item and the last item of items, in that order. The array always has at least one item.",
  "signature": "func solve(items: Array) -> Array:",
  "starter": "func solve(items: Array) -> Array:\n\treturn []",
  "tests": [
    {
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expect": [
        1,
        3
      ]
    },
    {
      "args": [
        [
          7
        ]
      ],
      "expect": [
        7,
        7
      ]
    },
    {
      "args": [
        [
          "a",
          "b"
        ]
      ],
      "expect": [
        "a",
        "b"
      ]
    },
    {
      "args": [
        [
          4,
          5,
          6,
          7,
          8
        ]
      ],
      "expect": [
        4,
        8
      ]
    }
  ],
  "hint": "`items[0]` is the first item. The last is `items[items.size() - 1]`, or the shortcut `items[-1]`.",
  "solution": "func solve(items: Array) -> Array:\n\treturn [items[0], items[-1]]"
}
