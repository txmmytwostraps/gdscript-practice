        3
      ]
    },
    {
      "name": "One item twice",
      "args": [
        [
          7
        ]
      ],
      "expect": [
        7,
        7
      ]
    },
    {
      "name": "Works with text",
      "args": [
        [
          "a",
          "b"
        ]
      ],
      "expect": [
        "a",
        "b"
      ]
