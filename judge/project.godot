; Engine configuration file.
; Godot 4.7.2 — GDScript practice judge

config_version=5

[application]

config/name="gdscript-practice-judge"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[debug]

; Off so the desktop validator matches the web export, where GDScript
; warnings do not exist. Otherwise a beginner-style ":=" on a Variant is
; an error here (Godot default) but fine on the site.
gdscript/warnings/enable=false
